#===============================================================================
# soc_top PnR / STA constraints
#
# Relaxed bring-up baseline for Sky130 / OpenLane.
# This is intentionally not a final chip-level signoff model.
#
#   - 15 ns clock target from config
#   - 2 ns external source latency
#   - 1 ns pre-CTS clock-network latency
#   - 1 ns setup uncertainty
#   - 1 ns clock transition
#   - 2~3 ns input timing window
#   - 0~3 ns output timing window
#===============================================================================

#-------------------------------------------------------------------------------
# CLOCK DEFINITION
#-------------------------------------------------------------------------------
set clk_period $::env(CLOCK_PERIOD)
set clk_port [get_ports clk]

create_clock \
    -name MAIN_CLOCK \
    -period $clk_period \
    $clk_port

set core_clock [get_clocks MAIN_CLOCK]

#-------------------------------------------------------------------------------
# CLOCK LATENCY
#
# External clock source latency : 2 ns
# Pre-CTS clock-network latency : 1 ns
# Post-CTS                     : use the propagated clock tree
#-------------------------------------------------------------------------------
set_clock_latency -source -min 2 $core_clock
set_clock_latency -source -max 2 $core_clock

if { [info exists ::env(OPENLANE_SDC_IDEAL_CLOCKS)] && $::env(OPENLANE_SDC_IDEAL_CLOCKS) } {
    set_clock_latency -min 1 $core_clock
    set_clock_latency -max 1 $core_clock
    unset_propagated_clock $core_clock
} else {
    set_propagated_clock $core_clock
}

#-------------------------------------------------------------------------------
# CLOCK UNCERTAINTY / TRANSITION
#-------------------------------------------------------------------------------
set_clock_uncertainty -setup 1 $core_clock
set_clock_transition 1 $core_clock

#-------------------------------------------------------------------------------
# FUNCTIONAL INPUT TIMING
#
# Relaxed block-level estimate for board / loader / GPIO / UART inputs.
# The 2 ns minimum removes the artificial input-hold failures seen with the
# earlier 1 ns assumption while remaining an explicit modeling assumption.
#-------------------------------------------------------------------------------
set functional_inputs [get_ports {
    rst
    ext_valid ext_target ext_last ext_addr* ext_wdata*
    gpio_in*
    uart_rx_valid uart_rx_data*
    uart_tx_ready
}]

set_input_delay -max 3 -clock $core_clock $functional_inputs
set_input_delay -min 2 -clock $core_clock $functional_inputs

# Model external logic as a medium-strength Sky130 buffer.
# Reset is excluded from the driving-cell model.
set driven_inputs [get_ports {
    ext_valid ext_target ext_last ext_addr* ext_wdata*
    gpio_in*
    uart_rx_valid uart_rx_data*
    uart_tx_ready
}]

set_driving_cell \
    -lib_cell sky130_fd_sc_hd__buf_2 \
    -pin X \
    $driven_inputs

#-------------------------------------------------------------------------------
# FUNCTIONAL OUTPUT TIMING
#
# No external receiver hold requirement is known at soc_top, so keep the
# output minimum delay at 0 ns for this relaxed block-level run.
#-------------------------------------------------------------------------------
set functional_outputs [get_ports {
    ext_ready
    gpio_out* gpio_oe*
    uart_rx_ready
    uart_tx_valid uart_tx_data*
    load_done
}]

set_output_delay -max 3 -clock $core_clock $functional_outputs
set_output_delay -min 0 -clock $core_clock $functional_outputs

# OpenSTA has no Synopsys load_of command.  Keep an explicit conservative
# top-level capacitive load.
set output_load 0.2
set_load $output_load $functional_outputs

#-------------------------------------------------------------------------------
# PVT / DERATE
#-------------------------------------------------------------------------------
set_timing_derate \
    -early \
    [expr {1.0 - ($::env(TIME_DERATING_CONSTRAINT) / 100.0)}]

set_timing_derate \
    -late \
    [expr {1.0 + ($::env(TIME_DERATING_CONSTRAINT) / 100.0)}]

#===============================================================================
