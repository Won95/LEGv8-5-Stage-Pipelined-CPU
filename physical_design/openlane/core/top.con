#===============================================================================
# core_pd_top PnR / STA constraints
#
# OpenLane2 usage:
#   - Yosys.Synthesis does NOT source this file.
#   - OpenROAD pre/mid-PnR uses it through PNR_SDC_FILE.
#   - Post-PnR STA uses it through SIGNOFF_SDC_FILE.
#
# Constraint policy:
#   - IDEC-style implementation clock and clock-latency assumptions
#   - OpenLane/Sky130 uncertainty, transition, DRC limits, load, and derate
#   - I/O max delay is derived from the remaining setup budget
#   - Input/output internal path target (Tmax): 6.0 ns
#   - Synchronous reset driven by the weakest Sky130 HD buffer
#===============================================================================

#-------------------------------------------------------------------------------
# CLOCK DEFINITION
#-------------------------------------------------------------------------------
set clk_period $::env(CLOCK_PERIOD)
set half_period [expr {$clk_period / 2.0}]
set clk_port [get_ports clk]

# IDEC/DC reference waveform style. For CLOCK_PERIOD=7 ns this is {3.5 7.0}.
create_clock \
    -name MAIN_CLOCK \
    -period $clk_period \
    -waveform [list $half_period $clk_period] \
    $clk_port

set core_clock [get_clocks MAIN_CLOCK]

# IDEC reference assumption:
#   external clock source -> design clock port : max 2 ns
#   design clock port     -> internal FF clock : max 1 ns before CTS
#
# Source latency remains valid after CTS because it is external to this block.
set_clock_latency -source -max 2.0 $core_clock

# Before CTS, use the IDEC 1 ns maximum internal clock-network estimate.
# After CTS, replace that estimate with the propagated physical clock tree.
if { [info exists ::env(OPENLANE_SDC_IDEAL_CLOCKS)] && $::env(OPENLANE_SDC_IDEAL_CLOCKS) } {
    set_clock_latency -max 1.0 $core_clock
    unset_propagated_clock $core_clock
} else {
    set_propagated_clock $core_clock
}

# Use OpenLane/Sky130 values for clock non-idealities.
set_clock_uncertainty $::env(CLOCK_UNCERTAINTY_CONSTRAINT) $core_clock
set_clock_transition  $::env(CLOCK_TRANSITION_CONSTRAINT)  $core_clock

#-------------------------------------------------------------------------------
# DESIGN-RULE CONSTRAINTS
#-------------------------------------------------------------------------------
set_max_fanout $::env(MAX_FANOUT_CONSTRAINT) [current_design]

if { [info exists ::env(MAX_TRANSITION_CONSTRAINT)] } {
    set_max_transition $::env(MAX_TRANSITION_CONSTRAINT) [current_design]
}

if { [info exists ::env(MAX_CAPACITANCE_CONSTRAINT)] } {
    set_max_capacitance $::env(MAX_CAPACITANCE_CONSTRAINT) [current_design]
}

#-------------------------------------------------------------------------------
# I/O TIMING BUDGET
#-------------------------------------------------------------------------------
# Budgeting intent:
#
#   input_delay(max)  = Tclk - uncertainty - Tmax(input port -> FF D)
#   output_delay(max) = Tclk - uncertainty - Tmax(FF Q -> output port)
#
# The internal input/output path target is intentionally set to 6.0 ns for this
# experiment. OpenSTA still performs the actual setup check with library setup
# time, clock latency/skew, derate, etc.; these values are a block-level budget.
set input_internal_tmax  6.0
set output_internal_tmax 6.0
set setup_uncertainty $::env(CLOCK_UNCERTAINTY_CONSTRAINT)

set input_delay_max  [expr {$clk_period - $setup_uncertainty - $input_internal_tmax}]
set output_delay_max [expr {$clk_period - $setup_uncertainty - $output_internal_tmax}]

puts "\[INFO\] Input internal Tmax : $input_internal_tmax ns"
puts "\[INFO\] Output internal Tmax: $output_internal_tmax ns"
puts "\[INFO\] Input max delay     : $input_delay_max ns"
puts "\[INFO\] Output max delay    : $output_delay_max ns"

#-------------------------------------------------------------------------------
# INPUT TIMING / DRIVE
#-------------------------------------------------------------------------------
# core_pd_top has only clk and synchronous rst as primary inputs.
set rst_port [get_ports rst]

set_input_delay -max $input_delay_max -clock $core_clock $rst_port
set_input_delay -min 0.0              -clock $core_clock $rst_port

# Model the non-clock input with the weakest Sky130 HD buffer.
# Clock quality is modeled separately with set_clock_transition above.
set_driving_cell \
    -lib_cell sky130_fd_sc_hd__buf_1 \
    -pin X \
    $rst_port

#-------------------------------------------------------------------------------
# OUTPUT TIMING / LOAD
#-------------------------------------------------------------------------------
# Treat the standalone monitor outputs as timed block outputs for this experiment.
set_output_delay -max $output_delay_max -clock $core_clock [all_outputs]
set_output_delay -min 0.0               -clock $core_clock [all_outputs]

# Use OpenLane's PDK-selected representative output load.
# OUTPUT_CAP_LOAD is in fF; OpenSTA set_load uses pF in this library setup.
set cap_load [expr {$::env(OUTPUT_CAP_LOAD) / 1000.0}]
set_load $cap_load [all_outputs]

#-------------------------------------------------------------------------------
# PVT / DERATE
#-------------------------------------------------------------------------------
# PVT corners are selected by OpenLane/PDK. Apply the standard OpenLane timing
# derate on top of the selected corner.
set_timing_derate -early [expr {1.0 - ($::env(TIME_DERATING_CONSTRAINT) / 100.0)}]
set_timing_derate -late  [expr {1.0 + ($::env(TIME_DERATING_CONSTRAINT) / 100.0)}]

#===============================================================================
