#===============================================================================
# core_pd_top PnR / STA constraints
#
# OpenLane2 usage:
#   - Yosys.Synthesis does NOT source this file.
#   - OpenROAD pre/mid-PnR uses it through PNR_SDC_FILE.
#   - Post-PnR STA uses it through SIGNOFF_SDC_FILE.
#
# Base behavior follows OpenLane2 base.sdc, with IDEC-specific clock latency
# assumptions added for this standalone core implementation stage.
#===============================================================================

#-------------------------------------------------------------------------------
# CLOCK
#-------------------------------------------------------------------------------
set clk_period $::env(CLOCK_PERIOD)
set half_period [expr {$clk_period / 2.0}]
set clk_port [get_ports clk]

# Match the IDEC/DC reference waveform for a 7 ns clock: {3.5 7.0}.
create_clock \
    -name MAIN_CLOCK \
    -period $clk_period \
    -waveform [list $half_period $clk_period] \
    $clk_port

set core_clock [get_clocks MAIN_CLOCK]

# External source latency from the IDEC reference.
set_clock_latency -source 2.0 $core_clock

# Pre-CTS estimated internal clock-network latency from the IDEC reference.
# After CTS/OpenROAD propagated-clock analysis, use the physical clock tree.
if { [info exists ::env(OPENLANE_SDC_IDEAL_CLOCKS)] && $::env(OPENLANE_SDC_IDEAL_CLOCKS) } {
    set_clock_latency 1.0 $core_clock
    unset_propagated_clock $core_clock
} else {
    set_propagated_clock $core_clock
}

set_clock_uncertainty $::env(CLOCK_UNCERTAINTY_CONSTRAINT) $core_clock
set_clock_transition  $::env(CLOCK_TRANSITION_CONSTRAINT)  $core_clock

#-------------------------------------------------------------------------------
# DESIGN-RULE CONSTRAINTS
#-------------------------------------------------------------------------------
set_max_fanout $::env(MAX_FANOUT_CONSTRAINT) [current_design]

if { [info exists ::env(MAX_TRANSITION_CONSTRAINT)] } {
    set_max_transition $::env(MAX_TRANSITION_CONSTRAINT) [current_design]
}

if { [info exists ::env(MAX_CAPACITANCE_CONSTRAINT)] } {
    set_max_capacitance $::env(MAX_CAPACITANCE_CONSTRAINT) [current_design]
}

#-------------------------------------------------------------------------------
# INPUT ENVIRONMENT
#-------------------------------------------------------------------------------
# core_pd_top has only clk and synchronous rst as primary inputs.
set rst_port [get_ports rst]
set input_delay_value [expr {$clk_period * $::env(IO_DELAY_CONSTRAINT) / 100.0}]
set_input_delay $input_delay_value -clock $core_clock $rst_port

# Follow OpenLane base.sdc for external-drive modeling.
set synth_drive_cell [split $::env(SYNTH_DRIVING_CELL) "/"]
set_driving_cell \
    -lib_cell [lindex $synth_drive_cell 0] \
    -pin [lindex $synth_drive_cell 1] \
    $rst_port

if { ![info exists ::env(SYNTH_CLK_DRIVING_CELL)] } {
    set ::env(SYNTH_CLK_DRIVING_CELL) $::env(SYNTH_DRIVING_CELL)
}
set synth_clk_drive_cell [split $::env(SYNTH_CLK_DRIVING_CELL) "/"]
set_driving_cell \
    -lib_cell [lindex $synth_clk_drive_cell 0] \
    -pin [lindex $synth_clk_drive_cell 1] \
    $clk_port

#-------------------------------------------------------------------------------
# OUTPUT ENVIRONMENT
#-------------------------------------------------------------------------------
set cap_load [expr {$::env(OUTPUT_CAP_LOAD) / 1000.0}]
set_load $cap_load [all_outputs]

# monitor_* outputs are observability-only ports for the standalone core PD run.
# They are not architectural timing endpoints.
set_false_path -to [all_outputs]

#-------------------------------------------------------------------------------
# PVT / DERATE
#-------------------------------------------------------------------------------
# Sky130 PVT corners are selected by OpenLane/PDK. Apply the standard OpenLane
# timing derate on top of the selected corner.
set_timing_derate -early [expr {1.0 - ($::env(TIME_DERATING_CONSTRAINT) / 100.0)}]
set_timing_derate -late  [expr {1.0 + ($::env(TIME_DERATING_CONSTRAINT) / 100.0)}]

#===============================================================================
