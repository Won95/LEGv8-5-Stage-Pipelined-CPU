#===============================================================================
# core_pd_top timing constraints
#
# Standalone CPU-core PD stage:
#   core + behavioral IMEM + behavioral DMEM
#
# The structure below follows the intent of the IDEC/DC reference constraint,
# but maps it to OpenLane2/OpenROAD/OpenSTA and to this core wrapper.
#===============================================================================

#-------------------------------------------------------------------------------
# CLOCK DEFINITION
#-------------------------------------------------------------------------------
# Functional target: 100 MHz -> 10 ns.
# For this implementation stage we intentionally tighten the target to 7 ns
# (about 142.9 MHz), matching the IDEC reference style of over-constraining PnR.
# CLOCK_PERIOD itself is supplied by config.json.
set clk_period $::env(CLOCK_PERIOD)
set half_period [expr {$clk_period / 2.0}]
set core_clk [get_ports clk]

# IDEC used waveform {3.5 7} for a 7 ns period.  For a single master clock the
# absolute phase origin is arbitrary, so we use the equivalent 50% duty waveform
# starting at t=0.
create_clock \
    -name MAIN_CLOCK \
    -period $clk_period \
    -waveform [list 0 $half_period] \
    $core_clk

set core_clock [get_clocks MAIN_CLOCK]

# External clock-source latency from the IDEC reference: 2 ns.
# This is delay before the clock reaches the design boundary.
set_clock_latency -source 2.0 $core_clock

# Estimated internal clock-network insertion delay from the IDEC reference: 1 ns.
# This estimate is meaningful only while the clock is ideal (pre-PnR/pre-CTS).
# After CTS, OpenLane exposes a propagated-clock mode and the actual routed clock
# tree delay must replace this estimate.
if { [info exists ::env(OPENLANE_SDC_IDEAL_CLOCKS)] && $::env(OPENLANE_SDC_IDEAL_CLOCKS) } {
    set_clock_latency 1.0 $core_clock
    unset_propagated_clock $core_clock
} else {
    set_propagated_clock $core_clock
}

# Sky130/OpenLane timing margins.  Do not hard-code SAED values here.
set_clock_uncertainty $::env(CLOCK_UNCERTAINTY_CONSTRAINT) $core_clock
set_clock_transition  $::env(CLOCK_TRANSITION_CONSTRAINT)  $core_clock

#-------------------------------------------------------------------------------
# DESIGN-RULE CONSTRAINTS
#-------------------------------------------------------------------------------
set_max_fanout $::env(MAX_FANOUT_CONSTRAINT) [current_design]

if { [info exists ::env(MAX_TRANSITION_CONSTRAINT)] } {
    set_max_transition $::env(MAX_TRANSITION_CONSTRAINT) [current_design]
}

if { [info exists ::env(MAX_CAPACITANCE_CONSTRAINT)] } {
    set_max_capacitance $::env(MAX_CAPACITANCE_CONSTRAINT) [current_design]
}

#-------------------------------------------------------------------------------
# ENVIRONMENTAL ATTRIBUTES
#-------------------------------------------------------------------------------
# IDEC reference:
#   set_driving_cell ... [all_inputs except HCLK/NRST]
#
# core_pd_top has only clk and rst as primary inputs.  There are no ordinary
# external data inputs at this stage, so there is no data-input driving-cell
# constraint to apply.  The clock slew is modeled with set_clock_transition.
#
# rst in this RTL is synchronous, unlike a typical asynchronous NRST reference.
# Give it an input arrival constraint instead of marking it ideal.
set rst_port [get_ports rst]
set input_delay_value [expr {$clk_period * $::env(IO_DELAY_CONSTRAINT) / 100.0}]
set_input_delay $input_delay_value -clock $core_clock $rst_port

# IDEC reference modeled output loading with a library input pin.  In OpenLane
# use the Sky130 PDK-selected OUTPUT_CAP_LOAD instead of a SAED32 cell.
set cap_load [expr {$::env(OUTPUT_CAP_LOAD) / 1000.0}]
set_load $cap_load [all_outputs]

# These monitor_* outputs exist only so standalone core logic remains observable
# after synthesis.  They are not architectural chip/SoC interfaces, so they do
# not define the CPU clock-frequency target.
set_false_path -to [all_outputs]

#-------------------------------------------------------------------------------
# OPERATING CONDITIONS / PVT
#-------------------------------------------------------------------------------
# IDEC/DC selected explicit SAED max/min operating conditions in the synthesis
# environment.  OpenLane2 selects Sky130 timing corners through its PDK/MCMM
# configuration, so no SAED-style set_operating_conditions command belongs here.
# Apply the standard Sky130/OpenLane timing derate instead.
set_timing_derate -early [expr {1.0 - ($::env(TIME_DERATING_CONSTRAINT) / 100.0)}]
set_timing_derate -late  [expr {1.0 + ($::env(TIME_DERATING_CONSTRAINT) / 100.0)}]

#-------------------------------------------------------------------------------
# IDEC/DC COMMANDS INTENTIONALLY NOT COPIED
#-------------------------------------------------------------------------------
# reset_design
#   Tool-session cleanup command; OpenLane creates/loads the design per step.
#
# set_max_area 0
#   Design Compiler synthesis optimization directive, not an SDC timing
#   constraint.  OpenLane area/utilization is controlled by its flow config.
#
# set_isolate_ports [all_outputs]
#   DC synthesis/output-buffering directive.  OpenLane/OpenROAD performs its own
#   buffering/repair during synthesis and physical optimization.
#
# set_ideal_network [get_ports "NRST HCLK"]
#   We do not keep the physical clock ideal after CTS.  OpenLane switches from
#   ideal to propagated clocks using OPENLANE_SDC_IDEAL_CLOCKS.  Our rst is also
#   synchronous, so globally idealizing it would hide a real timing path.
#
# set_fix_multiple_port_nets ...
#   DC netlist-cleanup directive.  Yosys/OpenLane performs equivalent netlist
#   normalization in its own synthesis flow; this is not an SDC command.
#===============================================================================
